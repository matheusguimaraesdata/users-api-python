# Configuração do Banco de Dados
# Para usar Neon (PostgreSQL):
# 1. Crie uma conta em https://neon.tech
# 2. Copie a connection string do dashboard
# 3. IMPORTANTE: Troque postgresql:// por postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://usuario:senha@host.neon.tech/neondb?sslmode=require

# Chave secreta para assinar tokens JWT
# Gere uma chave segura com: openssl rand -hex 32
SECRET_KEY=sua-chave-secreta-aqui

# Credenciais do usuário administrador da API
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sua-senha-forte-aqui
